[Unit]
Description=K1 模型保活定时器（开机预热一次 + 每 25 分钟续命，防止 ollama 换出）
Documentation=file:///root/k1-ai/deploy/install_k1_ai.sh

[Timer]
# ── 为什么是 25 分钟，而不是「闲置满 30 分钟再跑」 ──
# ollama 的 keep_alive 默认 30 分钟：最后一次请求之后 30 分钟，模型被换出。
# 若等到第 30 分钟才触发，模型此刻正好已经卸载，这次预热等于重新冷加载
# （实测 8.4–10.1 秒），而且卸载与重载之间有一段空窗——用户恰好在这 10 秒
# 里发一句话，仍然要等。提前到 25 分钟续一次，模型就永远不会进入卸载流程，
# 代价只是每 25 分钟一次 max_tokens=1 的请求（热态 1–2 秒，CPU 占用 <1%）。
#
# 45 秒的依据：ASR 在开机 40 秒打印「模型就绪」，视觉 31 秒出首帧，
# 叫声 22 秒开始监听。取 45 秒——比原来的 70 秒提前 25 秒，让模型在
# 前端发起首个请求之前就位。
#
# 为什么原来写 70 秒又改回来：实测那次 timer 在重负载下被推迟到 +140 秒
# 才执行，模型反而是被前端请求拉起来的（warmup 拿到 200 只用了 0.81 秒，
# 说明它跑的时候模型早就在内存里了，这次预热完全空转）。
# 固定时间点无法保证准时，所以时间提前 + 脚本轮询，两道保险一起上。
OnBootSec=45s

# 相对「本单元上次被激活」计时，而不是挂日历。oneshot 单元每次执行完回到
# inactive，所以每 25 分钟会被再拉起一次，形成保活心跳。
OnUnitActiveSec=25min

# 不必精确到秒：保活是为了挡住 30 分钟那条线，±30 秒无影响，
# 顺带让 systemd 能合并唤醒批次，少几次无谓的调度。
AccuracySec=30s

Unit=k1-warmup.service

[Install]
WantedBy=timers.target
